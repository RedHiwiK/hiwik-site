---
import AppLayout from '../layouts/AppLayout.astro';
import { t, pick, href, type Lang } from '../i18n';
import type { AppConfig } from '../data/types';
import { guidesFor } from '../lib/docs';

interface Props {
  lang: Lang;
  app: AppConfig;
}

const { lang, app } = Astro.props;
const s = t(lang);
const guides = await guidesFor(app.slug, lang);
const groups = (app.guideGroups ?? [{ key: '', name: { zh: '', en: '' } }])
  .map((g) => ({
    name: pick(g.name, lang),
    items: guides.filter((x) => (app.guideGroups ? x.doc.data.group === g.key : true)),
  }))
  .filter((g) => g.items.length > 0);
---

<AppLayout lang={lang} app={app} title={s.nav.guide} current="guide">
  <div class="wrap guide">
    <header class="head">
      <span class="eyebrow">{pick(app.name, lang)}</span>
      <h1>{s.nav.guide}</h1>
      <p>{s.guideLead}</p>
      <input type="search" placeholder={s.guideSearch} aria-label={s.guideSearch} data-guide-search />
    </header>

    {
      groups.map((g) => (
        <section class="group" data-guide-group>
          {g.name && <h2>{g.name}</h2>}
          <ul>
            {g.items.map(({ slug, doc }) => (
              <li data-guide-item data-text={`${doc.data.title} ${doc.data.description ?? ''}`.toLowerCase()}>
                <a href={href(lang, `/${app.slug}/guide/${slug}`)}>
                  <strong>{doc.data.title}</strong>
                  {doc.data.description && <span>{doc.data.description}</span>}
                  <i aria-hidden="true">→</i>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="empty" hidden data-guide-empty>{s.guideEmpty}</p>
  </div>
</AppLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-guide-search]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-guide-group]').forEach((group) => {
      let n = 0;
      group.querySelectorAll<HTMLElement>('[data-guide-item]').forEach((item) => {
        const hit = !q || (item.dataset.text ?? '').includes(q);
        item.hidden = !hit;
        if (hit) n++;
      });
      group.hidden = n === 0;
      shown += n;
    });
    const empty = document.querySelector<HTMLElement>('[data-guide-empty]');
    if (empty) empty.hidden = shown > 0;
  });
</script>

<style>
  .guide {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
    max-width: 56rem;
  }

  .head {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .head p {
    color: var(--ink-soft);
  }

  input {
    margin-top: 1rem;
    width: 100%;
    max-width: 26rem;
    height: 2.9rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    background: var(--paper-raised);
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
  }

  input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .group + .group {
    margin-top: 2.75rem;
  }

  .group h2 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0.75rem;
  }

  li a {
    position: relative;
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1.1rem 2.75rem 1.15rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    transition: border-color 0.2s, transform 0.3s var(--ease-out);
  }

  li a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  li strong {
    font-weight: 650;
  }

  li span {
    font-size: 0.875rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  li i {
    position: absolute;
    right: 1.1rem;
    top: 1.1rem;
    font-style: normal;
    color: var(--ink-faint);
  }

  .empty {
    color: var(--ink-faint);
  }
</style>
