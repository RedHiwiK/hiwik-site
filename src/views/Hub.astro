---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { t, pick, href, altHref, type Lang } from '../i18n';
import { apps } from '../data/apps';
import { appSections } from '../lib/sections';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
const cards = await Promise.all(
  apps.map(async (app) => ({
    app,
    links: (await appSections(app, lang)).filter((x) => ['support', 'privacy', 'terms'].includes(x.key)),
  })),
);
---

<Base lang={lang} title={s.hubTitle} description={s.hubDescription}>
  <header class="hub-header">
    <div class="wrap bar">
      <a class="mark" href={href(lang, '/')}>KunKunRed<i aria-hidden="true"></i></a>
      <div class="bar-end">
        <a class="about" href={s.authorUrl} target="_blank" rel="noopener">{s.aboutAuthor}</a>
        <ThemeToggle label={s.themeLabel} />
        <a class="lang" href={altHref(lang, Astro.url.pathname)} aria-label={s.langSwitchLabel} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{s.langSwitch}</a>
      </div>
    </div>
  </header>

  <main>
    <section class="intro">
      <div class="intro-bg" aria-hidden="true"></div>
      <div class="wrap intro-inner">
        <div class="icon-row" data-enter aria-hidden="true">
          {apps.map((app) => <Image src={app.icon} alt="" width={128} height={128} class="row-icon" loading="eager" />)}
        </div>
        <span class="eyebrow" data-enter style="--i:1">{s.hubEyebrow}</span>
        <h1 data-enter style="--i:2">{s.hubStatement}</h1>
        <p data-enter style="--i:3">{s.hubLead}</p>
      </div>
    </section>

    <section class="wrap grid" aria-label={s.hubApps}>
      {
        cards.map(({ app, links }, i) => (
          <article class="card" data-app={app.slug} data-enter style={`--i:${i + 4}`}>
            <div class="stage">
              <Image src={app.icon} alt="" width={256} height={256} class="stage-glow" loading="eager" aria-hidden="true" />
              <Image src={app.icon} alt="" width={256} height={256} class="stage-icon" loading="eager" />
              {app.comingSoon && <span class="badge">{s.comingSoon}</span>}
            </div>
            <div class="body">
              <h2>
                <a href={href(lang, `/${app.slug}`)} class="main-link">
                  {pick(app.name, lang)}
                </a>
              </h2>
              <p class="headline">{pick(app.headline, lang)}</p>
              <p class="tagline">{pick(app.tagline, lang)}</p>
            </div>
            <div class="card-foot">
              <span class="go">
                {s.visit}
                <Icon name="arrow-right" class="go-icon" />
              </span>
              <nav class="mini-links" aria-label={pick(app.name, lang)}>
                {links.map((l) => <a href={l.url}>{l.label}</a>)}
              </nav>
            </div>
          </article>
        ))
      }
    </section>
  </main>

  <footer class="hub-footer">
    <div class="wrap foot">
      <span>© 2026 KunKunRed</span>
      <a href={s.authorUrl} target="_blank" rel="noopener">{s.aboutAuthor} ↗</a>
    </div>
  </footer>
</Base>

<style>
  .hub-header {
    position: relative;
    z-index: 2;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .mark {
    position: relative;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .mark i {
    position: absolute;
    top: 0.15rem;
    right: -0.55rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--brand);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .about,
  .lang {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--ink-soft);
    transition: color 0.2s, background-color 0.2s;
  }

  .about:hover,
  .lang:hover {
    color: var(--ink);
    background: var(--paper-sunken);
  }

  .lang {
    font-size: 0.78rem;
    font-weight: 600;
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  /* ---------- Intro ---------- */
  .intro {
    position: relative;
    margin-top: -4rem;
    padding-top: 4rem;
    overflow: clip;
    text-align: center;
  }

  .intro-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 55% at 20% 10%, color-mix(in oklch, var(--app-vitae) 12%, transparent), transparent 70%),
      radial-gradient(40% 55% at 80% 5%, color-mix(in oklch, var(--app-cutepet) 13%, transparent), transparent 70%),
      radial-gradient(45% 50% at 50% 40%, color-mix(in oklch, var(--app-moonlog) 9%, transparent), transparent 70%);
  }

  .intro-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 20%, black, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 20%, black, transparent 75%);
  }

  .intro-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(3rem, 9vw, 6rem) clamp(3rem, 7vw, 4.5rem);
  }

  .icon-row {
    display: flex;
    margin-bottom: 2rem;
  }

  .row-icon {
    width: clamp(3.25rem, 7vw, 4rem);
    height: auto;
    border-radius: 22.5%;
    box-shadow:
      0 0 0 2px var(--paper),
      var(--icon-shadow);
  }

  .row-icon + .row-icon {
    margin-left: -0.6rem;
  }

  .row-icon:nth-child(odd) {
    rotate: -6deg;
  }

  .row-icon:nth-child(even) {
    rotate: 5deg;
    translate: 0 6px;
  }

  .intro .eyebrow {
    color: var(--brand);
  }

  h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.5rem, 6.4vw, 4.75rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.08;
    white-space: pre-line;
  }

  .intro p {
    margin-top: 1.4rem;
    max-width: 38rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--ink-soft);
  }

  /* ---------- Cards ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: calc(var(--radius) + 12px);
    background: var(--paper-raised);
    box-shadow:
      0 0 0 1px var(--rule),
      var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px var(--accent-line),
      var(--shadow-lg);
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 8;
    background:
      radial-gradient(60% 80% at 50% 100%, color-mix(in oklch, var(--accent) 22%, transparent), transparent 75%),
      linear-gradient(180deg, var(--accent-soft), transparent);
    overflow: hidden;
  }

  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, black, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, black, transparent 80%);
    opacity: 0.7;
  }

  .stage-icon,
  .stage-glow {
    grid-area: 1 / 1;
    width: clamp(5.5rem, 12vw, 7rem);
    height: auto;
    border-radius: 22.5%;
  }

  .stage-icon {
    position: relative;
    z-index: 1;
    box-shadow:
      0 0 0 0.5px var(--rule-strong),
      var(--icon-shadow);
    transition: transform 0.5s var(--ease-out);
  }

  .stage-glow {
    filter: blur(26px) saturate(1.4);
    opacity: 0.6;
    translate: 0 16%;
  }

  .card:hover .stage-icon {
    transform: translateY(-4px) rotate(-4deg) scale(1.03);
  }

  .badge {
    position: absolute;
    z-index: 1;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--paper-raised);
    box-shadow: 0 0 0 1px var(--accent-line);
  }

  .body {
    padding: 1.5rem 1.75rem 0;
    flex: 1;
  }

  .card h2 {
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--accent);
  }

  /* 整张卡片可点，底部小链接叠在其上 */
  .main-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .main-link:focus-visible {
    outline: none;
  }

  .main-link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: inherit;
  }

  .headline {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 1.65rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
    word-break: keep-all;
  }

  .tagline {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin: 1.4rem 1.75rem 0;
    padding: 1rem 0 1.4rem;
    border-top: 1px solid var(--rule);
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  :global(.go-icon) {
    width: 1rem;
    height: 1rem;
    transition: translate 0.3s var(--ease-out);
  }

  .card:hover .go {
    color: var(--accent);
  }

  .card:hover :global(.go-icon) {
    translate: 3px 0;
  }

  .mini-links {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 0.25rem;
  }

  .mini-links a {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    transition: color 0.2s, background-color 0.2s;
  }

  .mini-links a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .hub-footer {
    margin-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--ink-faint);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
  }

  .foot a:hover {
    color: var(--brand);
  }
</style>
