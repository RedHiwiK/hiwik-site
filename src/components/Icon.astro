---
import * as icons from 'lucide-static';

interface Props {
  /** lucide 图标名，kebab-case */
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
const key = name.replace(/(^|-)(\w)/g, (_, __, c: string) => c.toUpperCase()) as keyof typeof icons;
const svg = icons[key];
if (typeof svg !== 'string') throw new Error(`Unknown lucide icon: ${name}`);
const html = svg.replace('<svg', '<svg aria-hidden="true" focusable="false"');
---

<span class:list={['icon', className]} set:html={html} />

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 1.75;
  }
</style>
